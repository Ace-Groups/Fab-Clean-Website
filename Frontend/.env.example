# Public API base (production builds). Leave empty in local Vite to use /api proxy.
VITE_API_URL=

# MSG91 OTP widget (public widget credentials — AuthKey stays server-only in Backend).
# Prefer loading these via GET /api/auth/otp-widget-config from Backend env instead.
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=
