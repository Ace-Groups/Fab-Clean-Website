# Production builds bake this into the client bundle.
# Must be the public API origin (no trailing /api required; client adds /api paths).
VITE_API_URL=https://fab-clean-api-254040893134.us-central1.run.app

# Optional: skip GET /api/auth/otp-widget-config by baking public widget credentials.
# Prefer server config (MSG91_WIDGET_ID + MSG91_OTP_VERIFICATION_TOKEN on Backend).
# Never put MSG91_AUTH_KEY here.
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=
